{
  "name": "@dicexp/nova",
  "version": "0.1.0",
  "description": "The compiler-based dicexp evaluator (WASM).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "wasm"
  ],
  "types": "./dist/lib.d.ts",
  "module": "./dist/lib.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    },
    "./wasm/*": "./wasm/*",
    "./internal": "./internal.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umajho/dicexp.git"
  },
  "keywords": [
    "dicexp"
  ],
  "author": "Umaĵo",
  "license": "MIT",
  "homepage": "https://github.com/umajho/dicexp/tree/main/nova/packages/nova#readme",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest --dir=test --run",
    "bench": "vitest --dir=bench --run",
    "build": "tsup"
  },
  "devDependencies": {
    "@dicexp/interface": "workspace:*",
    "@dicexp/naive-evaluator": "workspace:*",
    "@dicexp/naive-evaluator-builtins": "workspace:*",
    "@dicexp/naive-evaluator-runtime": "workspace:*",
    "@dicexp/test-utils-for-executing": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
