set fallback

prepare:
	just build-lezer
	# Nova wasm assets are gitignored build artifacts; the `?url` imports
	# need them at dev/build time.
	just build-nova-wasm

build: prepare
	pnpm exec vite build
	gzip -k dist/**/*.js
	brotli -k dist/**/*.js

type-check: prepare
	tsc --noEmit

serve: build
	just serve-no-build

serve-no-build:
	# https://github.com/http-party/http-server
	http-server ./dist --brotli --gzip
